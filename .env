# Base URL used by src/services/api.js for every request.
# Absolute URL -> calls the published API directly.
# The API CORS policy must allow this frontend's origin (see back/Reword-back/Program.cs).
VITE_API_BASE_URL=https://reword-hub.runasp.net/api

# Target for the Vite dev-server proxy on /api (only used if VITE_API_BASE_URL is left as '/api').
VITE_API_TARGET=https://reword-hub.runasp.net

# Business entity used by default at login (1 = General).
VITE_BUSINESS_ENTITY_ID=1
